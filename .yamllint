---
extends: default

# 80-char default is unrealistic for inline ansible commands and compose
# build args. Keep a generous cap so genuinely runaway lines still flag.
# `truthy` keeps yamllint flagging bare `on:` (YAML 1.1 boolean) in workflow
# files — we quote `"on":` in test.yml so this rule stays on as a safety net.
rules:
  line-length:
    max: 140
    level: error
